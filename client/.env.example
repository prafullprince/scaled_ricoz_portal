NODE_ENV=production

# Public HTTPS URL of the deployed Ricoz Portals API, including its API prefix.
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
# Optional explicit chat gateway URL. Use wss:// in production.
NEXT_PUBLIC_CHAT_WS_URL=wss://api.example.com/ws/chat
# Allow slower production cold starts and analytics requests to complete.
NEXT_PUBLIC_API_TIMEOUT_MS=30000
