NODE_ENV=production
PORT=4000

# OpenAI Agents SDK powers the assistant and Daily Planner.
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-5-nano
# Optional planner-only override; falls back to OPENAI_MODEL.
OPENAI_PLANNER_MODEL=gpt-5-nano

# Production MongoDB connection string.
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/ricoz_portals

# Redis backs chat persistence queues and cross-instance realtime fanout.
REDIS_URL=redis://localhost:6379
# BullMQ requires a shared Redis Cluster hash tag when using Valkey Serverless.
BULLMQ_PREFIX={bull}
# Set false only when `npm run worker:chat` runs as a separate process.
CHAT_EMBEDDED_WORKER=true
CHAT_WORKER_CONCURRENCY=20

# Cloudinary stores chat images, videos, and documents.
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

# LiveKit powers group/community calls (SFU). One-to-one calls stay on direct WebRTC.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret

# RazorpayX Payouts. Enable only after activating a RazorpayX account and allowlisting the API server IP.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
# Configure the same secret on RazorpayX and subscribe to payout.pending, payout.queued,
# payout.initiated, payout.processed, payout.updated, payout.reversed, payout.failed and payout.rejected.
RAZORPAYX_WEBHOOK_SECRET=

# Coturn REST authentication for direct calls across restrictive networks.
# Configure the same shared secret on the TURN server; never put it in the mobile app.
TURN_URLS=
TURN_SHARED_SECRET=

# Use separate, random secrets of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-random-production-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-production-refresh-secret

# Comma-separated frontend origins. No trailing slash.
CLIENT_URL=https://innovation.ricoz.in

# SMTP relay (ZeptoMail, SES, Gmail SMTP, etc.).
SMTP_HOST=smtp.zeptomail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=emailapikey
SMTP_PASS=replace-with-your-smtp-password-or-zeptomail-token
EMAIL_FROM=notifications@example.com
EMAIL_FROM_NAME=Ricoz Innovation
# Optional shared secret for email-provider campaign status callbacks.
EMAIL_CAMPAIGN_WEBHOOK_SECRET=
# Optional backwards-compatible ZeptoMail overrides. Generic SMTP variables above take precedence.
# ZEPTOMAIL_SMTP_HOST=smtp.zeptomail.com
# ZEPTOMAIL_SMTP_PORT=587
# ZEPTOMAIL_SMTP_USER=emailapikey
# ZEPTOMAIL_SMTP_PASSWORD=replace-with-zeptomail-smtp-token
# ZEPTOMAIL_FROM_EMAIL=notifications@example.com
# ZEPTOMAIL_FROM_NAME=Ricoz Innovation
# ZEPTOMAIL_CONTACT_TO=contact@example.com

# Public origin of this API, used by private offer PDF links (HTTPS in production).
PUBLIC_API_URL=https://innovationapi.ricoz.in
# Integration credentials are encrypted at rest. Generate with: openssl rand -hex 32
# Keep this key stable, private, and backed up; changing it makes existing credentials unreadable.
INTEGRATIONS_ENCRYPTION_KEY=
# Social account OAuth applications. Register the exact redirect URI values in each provider console.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://api.example.com/api/v1/marketing/social/oauth/callback/linkedin
LINKEDIN_API_VERSION=202610
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0
META_REDIRECT_URI=https://api.example.com/api/v1/marketing/social/oauth/callback/meta
WHATSAPP_REDIRECT_URI=https://api.example.com/api/v1/marketing/social/oauth/callback/whatsapp
META_WEBHOOK_VERIFY_TOKEN=
# Optional canonical frontend URL; otherwise the first CLIENT_URL origin is used.
OFFER_CLIENT_URL=https://innovation.ricoz.in
# Optional HR mailbox and published policy URLs. Without them, use the contact page / offer terms.
OFFER_HR_EMAIL=
OFFER_PRIVACY_URL=
OFFER_TERMS_URL=
