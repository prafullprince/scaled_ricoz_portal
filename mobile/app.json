{
  "expo": {
    "name": "Ricoz Innovation",
    "slug": "ricoz-innovation",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ricoz",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.ricoz.innovation",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Ricoz Innovation to use your microphone during calls and voice messages."
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "bitcode": false
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "in.ricoz.innovation",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Ricoz Innovation to attach your location to attendance and chat updates."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Ricoz Innovation to select photos for your profile and messages.",
          "cameraPermission": "Allow Ricoz Innovation to use your camera for calls, profile photos and messages.",
          "microphonePermission": false
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow Ricoz Innovation to use your camera during calls.",
          "microphonePermission": "Allow Ricoz Innovation to use your microphone during calls."
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Ricoz Innovation to record voice messages."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D65A31",
          "defaultChannel": "updates"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-audio",
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9f2e90f9-31c4-49c3-b5b2-f9101664d400"
      }
    },
    "owner": "ricozmedia"
  }
}
